generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  HUMAN
  AGENT
}

enum ChatKind {
  DM
  GROUP
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String?  @unique
  passwordHash String?
  kind         UserKind @default(HUMAN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     ChatMember[]
  messages        Message[]
  memories        Memory[]
  memoryAudiences MemoryAudience[]
}

model Chat {
  id        String   @id @default(cuid())
  kind      ChatKind
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]
}

model ChatMember {
  chatId   String
  userId   String
  joinedAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Memory {
  id         String           @id @default(cuid())
  userId     String
  content    String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  visibility MemoryVisibility @default(PARTICIPANTS)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience MemoryAudience[]

  @@index([userId])
}

model MemoryAudience {
  memoryId String
  userId   String

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([memoryId, userId])
  @@index([userId])
}

enum MemoryVisibility {
  PRIVATE
  PARTICIPANTS
}
